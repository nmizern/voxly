# Copy to .env and fill in. Only the secrets for your chosen setup are needed.

# --- Core ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VOXLY_MODE=scale                 # lite | scale

# --- Speech-to-text provider ---
STT_PROVIDER=yandex              # yandex | openai | groq | deepgram | whisper
STT_LANGUAGE=ru-RU

# Yandex SpeechKit (needs S3 below)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-transcribe

# Groq
GROQ_API_KEY=
# GROQ_MODEL=whisper-large-v3-turbo

# Deepgram
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# Self-hosted Whisper (OpenAI-compatible server)
# WHISPER_BASE_URL=http://localhost:9000/v1

# --- Object storage (Yandex provider only) ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=voxly-audio

# --- Infrastructure (scale mode) ---
DATABASE_URL=postgres://voxly_user:voxly_password@localhost:5432/voxly?sslmode=disable
RABBITMQ_URL=amqp://voxly:voxly_password@localhost:5672/
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

WORKER_CONCURRENCY=4

# --- Access control ---
ACCESS_MODE=open                 # open | allowlist
# ACCESS_ALLOWED_USER_IDS=111,222
# ACCESS_ALLOWED_CHAT_IDS=-1001234567890
# ACCESS_ADMIN_IDS=111

# --- Observability ---
LOG_LEVEL=info                   # debug | info | warn | error
LOG_FORMAT=json                  # json | console
METRICS_ADDR=:9090
